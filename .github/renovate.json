{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "matchPackageNames": [
        "gpui",
        "gpui_platform",
        "gpui_util"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Rust minor/patch dependencies"
    }
  ]
}
